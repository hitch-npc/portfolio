{
  "name": "eldar-dalov-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Портфолио TBCS™ (Eldar Swartz). Токены — единый источник истины, деплой на GitHub Pages.",
  "scripts": {
    "dev": "npm run build:tokens && npm run build:tts && npm run fetch:fontshare && vite",
    "build:tokens": "node tooling/build-tokens.mjs",
    "build": "npm run build:tokens && npm run build:tts && npm run fetch:fontshare && vite build",
    "preview": "vite preview",
    "lint": "node tooling/guardrail.mjs",
    "check": "node tooling/build-tokens.mjs --check && node tooling/guardrail.mjs",
    "build:sandbox": "npm run build && node tooling/build-sandbox.mjs",
    "build:tts": "node tooling/build-tts.mjs",
    "fetch:fonts": "node tooling/fetch-fonts.mjs",
    "fetch:fontshare": "node tooling/fetch-fontshare.mjs",
    "lab": "vite --open /gallery.html",
    "lab:field": "vite --open /field.html",
    "posters": "node tooling/posters.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
